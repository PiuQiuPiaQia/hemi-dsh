# Public settings for a local Hemi community build.
# macOS uses CSC_LINK/CSC_KEY_PASSWORD in secrets/macos-signing.env.
# Community Windows requires no signing secret file.
DSH_DESKTOP_APP_ID=ai.hemi.dsh.desktop
DSH_DESKTOP_AUTO_UPDATE_ENV=production
HEMI_DESKTOP_GITHUB_REPOSITORY=PiuQiuPiaQia/hemi-dsh
HEMI_DESKTOP_GITHUB_FEED_BRANCH=desktop-update-feeds
HEMI_DESKTOP_UPDATE_POLICY=disabled
HEMI_DESKTOP_SIGNING_MODE=community
