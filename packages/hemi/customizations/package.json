{
  "name": "@deepseek-ai/dsh-hemi-customizations",
  "description": "Electron adapters for Hemi fork customizations",
  "version": "0.2.2-alpha.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./preload": {
      "types": "./lib/types/preload.d.ts",
      "default": "./lib/preload.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./github-distribution": {
      "types": "./release/config.d.mts",
      "default": "./release/config.mjs"
    },
    "./github-release": {
      "types": "./release/publish.d.mts",
      "default": "./release/publish.mjs"
    },
    "./github-release-command": {
      "types": "./release/command.d.mts",
      "default": "./release/command.mjs"
    },
    "./github-community-signing": {
      "types": "./release/signing.d.mts",
      "default": "./release/signing.mjs"
    },
    "./github-community-cua": {
      "types": "./release/cua.d.mts",
      "default": "./release/cua.mjs"
    },
    "./github-community-setup": {
      "types": "./release/setup.d.mts",
      "default": "./release/setup.mjs"
    },
    "./desktop-branding": {
      "types": "./release/identity.d.mts",
      "default": "./release/identity.mjs"
    },
    "./desktop-artwork": {
      "types": "./release/artwork.d.mts",
      "default": "./release/artwork.mjs"
    },
    "./web-branding": {
      "types": "./release/web.d.mts",
      "default": "./release/web.mjs"
    }
  },
  "files": [
    "lib/index.js",
    "lib/preload.js",
    "release/*.mjs",
    "release/*.d.mts",
    "release/*.cer",
    "src/desktop-startup.css",
    "artwork",
    "lib/types/**/*.d.ts"
  ],
  "dsh": null,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiuQiuPiaQia/hemi-dsh.git",
    "directory": "packages/hemi/customizations"
  },
  "peerDependencies": {
    "electron": "^44.7.0",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-hemi-model-access": "workspace:*"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-hemi-model-access": "workspace:*",
    "@deepseek-ai/dsh-hemi-model-settings": "workspace:*",
    "vite": "^6.4.3"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "private": true,
  "dependencies": {
    "js-yaml": "^4.3.2",
    "semver": "^7.8.5",
    "@electron/osx-sign": "1.3.3",
    "execa": "^10.0.1",
    "plist": "^3.1.0"
  }
}
